# Copie para .env e ajuste. Nunca versione o .env.

# Caminho do arquivo SQLite (ignorado pelo git).
DATABASE_URL=./data/app.db

# --- Seed (yarn db:seed) ---
# Admin inicial. Senha: mínimo 8 caracteres, com letra e número.
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=adminmaster@123
SEED_ADMIN_NAME=Administrador

# Opcional: cria 3 viewers de demonstração (viewer1..3@exemplo.com; o 3º bloqueado).
SEED_VIEWER_PASSWORD=

# Opcionais: seed do gerador, data final (YYYY-MM-DD; padrão: hoje em São Paulo) e dias.
SEED_RANDOM_SEED=20260928
SEED_END_DATE=
SEED_DAYS=365

# --- Auth.js ---
# Segredo do JWT (obrigatório). Gere com: openssl rand -base64 32
AUTH_SECRET=
# Necessário fora da Vercel (self-host). Use atrás de proxy reverso confiável.
AUTH_TRUST_HOST=true
# Proxies que acrescentam ao X-Forwarded-For à frente da app (o IP do cliente é lido à
# esquerda deles). 1 = só o próprio Next/um proxy reverso.
AUTH_TRUSTED_PROXY_HOPS=1
